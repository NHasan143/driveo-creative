# Driveo Exclusive platform — repository-wide ignore rules.
# Each app keeps its own .gitignore for app-specific output (see frontend/.gitignore).

# ==== Separate repositories ===============================================
# Lovable prototype: design reference with its own git history
# (https://github.com/NHasan143/driveo-creative). Never commit it here.
/driveo-creative/

# ==== Secrets & local configuration =======================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
!debug.keystore
secrets/
credentials*.json
service-account*.json
google-services.json
GoogleService-Info.plist

