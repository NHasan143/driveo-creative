# Template for backend/.env.local, the single local secrets file for the
# backend. Never commit .env.local. From backend/:
#
#   cp .env.example .env.local
#   neon env pull          # fills in the Neon section below
#
# Then generate a Django secret key and paste it in:
#   .venv/Scripts/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# In Docker/CI, set these as real environment variables instead.

# ==== Neon - managed by `neon deploy` / `neon env pull`; don't edit by hand
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ==== Django (backend) - not managed by Neon; `neon env pull` keeps these lines
DJANGO_SECRET_KEY=
# Defaults to false when unset. Never true in production.
DJANGO_DEBUG=true
# Comma-separated host names.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Website origins allowed to call the API from the browser (comma-separated, with scheme).
# The content admin (/admin on the website) signs staff in from these origins too.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins trusted for CSRF on staff writes. Empty = same as CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=
# Lax works while the website and API share a site (localhost:3000 + localhost:8000,
# or driveoexclusive.com + api.driveoexclusive.com). None only for unrelated domains (HTTPS).
SESSION_COOKIE_SAMESITE=Lax
# Content admin sign-in attempts per IP (DRF rate syntax).
STAFF_SIGN_IN_RATE=20/hour
# Customer accounts (per IP).
ACCOUNT_SIGN_IN_RATE=20/hour
ACCOUNT_REGISTER_RATE=10/hour
PASSWORD_RESET_RATE=5/hour
# Bucket declared in neon.ts.
AWS_STORAGE_BUCKET_NAME=assets

# ==== Background jobs (Celery + Redis)
REDIS_URL=redis://localhost:6379/0
# true = run alert tasks inside the request (local work without Redis). Never in production.
CELERY_TASK_ALWAYS_EAGER=false
# Max bookings per visitor IP (DRF rate syntax).
BOOKINGS_RATE=10/hour

# ==== Bookings
# Public URL of this backend, used for dashboard links in alerts.
BACKEND_BASE_URL=http://localhost:8000
# Public URL of the website, used for links in emails (password resets).
WEBSITE_BASE_URL=http://localhost:3000
# Comma-separated. Leave empty to skip a channel (shown as "skipped" in the admin).
BOOKING_ALERT_EMAILS=
# Comma-separated E.164 numbers, e.g. +447700900123
BOOKING_ALERT_WHATSAPP=
# Customers change or cancel online until this many hours before pickup.
BOOKING_CANCEL_NOTICE_HOURS=24
# Minimum notice for a new booking, in the city's time (urgent journeys by phone).
BOOKING_MIN_NOTICE_HOURS=3

# ==== Production behind Cloudflare + Nginx (leave empty locally)
# Production also sets DJANGO_DEBUG=false and DJANGO_ALLOWED_HOSTS=<api host>,localhost
# (localhost is for the container health check).
# true = trust Nginx's X-Forwarded-Proto. Only behind a proxy that overwrites it.
DJANGO_BEHIND_PROXY=
# true = redirect plain HTTP to HTTPS (the health check is exempt).
DJANGO_SSL_REDIRECT=
# HSTS lifetime in seconds. Start with 3600; raise to 31536000 once HTTPS is known to work.
DJANGO_HSTS_SECONDS=
DJANGO_HSTS_INCLUDE_SUBDOMAINS=
# Proxies in front of Django (Cloudflare + Nginx = 2), so rate limits see the visitor's IP.
DRF_NUM_PROXIES=
# Shared rate-limit cache for all web workers, e.g. redis://redis:6379/1 (Celery uses /0).
CACHE_REDIS_URL=
# Gunicorn worker processes in the API container (2–4 per CPU core).
WEB_CONCURRENCY=3

# ==== Email (SMTP). Leave SMTP_HOST empty to print emails to the console.
DEFAULT_FROM_EMAIL=Driveo Exclusive <no-reply@driveoexclusive.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ==== Twilio WhatsApp (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: your WhatsApp-enabled Twilio number, or the sandbox +14155238886 for testing.
TWILIO_WHATSAPP_FROM=
# Approved template (HX...) for production. Empty = free-form text (sandbox / 24-hour window only).
TWILIO_WHATSAPP_CONTENT_SID=
