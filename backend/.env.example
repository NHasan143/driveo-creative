# Template for backend/.env.local, the single local secrets file for the
# backend. Never commit .env.local. From backend/:
#
#   cp .env.example .env.local
#   neon env pull          # fills in the Neon section below
#
# Then generate a Django secret key and paste it in:
#   .venv/Scripts/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# In Docker/CI, set these as real environment variables instead.

# ==== Neon - managed by `neon deploy` / `neon env pull`; don't edit by hand
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ==== Django (backend) - not managed by Neon; `neon env pull` keeps these lines
DJANGO_SECRET_KEY=
# Defaults to false when unset. Never true in production.
DJANGO_DEBUG=true
# Comma-separated host names.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Bucket declared in neon.ts.
AWS_STORAGE_BUCKET_NAME=assets
