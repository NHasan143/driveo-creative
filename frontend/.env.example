# Public origin of this website, used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the shared Django REST API (no trailing slash).
# The quote form posts to {NEXT_PUBLIC_API_BASE_URL}/v1/quote-requests/
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# false = talk to the Django API above (run the backend, see the root README).
# true = answer API calls with local mocks, to work on the website without the backend.
# Mock mode is also used when no API URL is set.
NEXT_PUBLIC_API_MOCK=false

# Where the content admin at /admin keeps content:
# local = demo mode, saved in this browser only (no sign-in, nothing reaches the website).
# api   = the Django API above (backend/content/), with staff sign-in. The backend's
#         CORS_ALLOWED_ORIGINS must include this site's origin.
NEXT_PUBLIC_ADMIN_CONTENT_SOURCE=local

# Server-side. The content admin at /admin is always on in development. Production builds
# answer 404 there unless this is true. Turn it on only with NEXT_PUBLIC_ADMIN_CONTENT_SOURCE=api,
# so editors sign in and their changes are saved in the database.
ADMIN_ENABLED=false
