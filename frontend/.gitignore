# Website (Next.js) — rules specific to this app.
# Platform-wide rules (OS, editors, secrets) live in ../.gitignore.

# ---- Dependencies --------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js build output -------------------------------------------------
/.next/
/out/
/build/

# Generated by `next dev` / `next build` / `next typegen`
next-env.d.ts
*.tsbuildinfo

# ---- Tooling caches -------------------------------------------------------
.eslintcache
.turbo/
.swc/

# ---- Testing --------------------------------------------------------------
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---- Logs -----------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Environment ----------------------------------------------------------
# Local values and secrets stay out of git; the template is committed.
.env*
!.env.example

# ---- Hosting --------------------------------------------------------------
.vercel/

# ---- Misc -----------------------------------------------------------------
*.pem
.DS_Store
