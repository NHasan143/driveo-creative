# Compose variables for infra/docker-compose.yml. Copy to infra/.env on the server.

# Public host names; Cloudflare DNS points both at this server.
SITE_HOST=driveoexclusive.com
API_HOST=api.driveoexclusive.com

# Images. The frontend deploy workflow passes FRONTEND_IMAGE itself on every deploy.
FRONTEND_IMAGE=ghcr.io/nhasan143/driveo-frontend:production
BACKEND_IMAGE=ghcr.io/nhasan143/driveo-backend:production

# The content admin at https://SITE_HOST/admin (staff sign-in through the API).
ADMIN_ENABLED=true
