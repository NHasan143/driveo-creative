# Django settings for the backend, worker, beat and migrate containers.
# Copy to infra/backend.env on the server and fill in the secrets.
# Every variable is explained in backend/.env.example.
#
# Write values WITHOUT quotes: the file is read raw, so quotes would become part of
# the value (and `$` needs no escaping).
# REDIS_URL and CACHE_REDIS_URL are set by docker-compose.yml.

# ==== Neon (from `neon env pull` on the production branch)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=assets

# ==== Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# The API host; `backend` for the website's server-side calls; localhost for the health check.
DJANGO_ALLOWED_HOSTS=api.driveoexclusive.com,backend,localhost
CORS_ALLOWED_ORIGINS=https://driveoexclusive.com
SESSION_COOKIE_SAMESITE=Lax

# ==== Behind Cloudflare + Nginx (see README "Backend production settings")
DJANGO_BEHIND_PROXY=true
# Off here: Nginx already sends every outside http:// request to https://, and
# Django's own redirect would break the website's plain-HTTP calls inside the
# Docker network (http://backend:8000).
DJANGO_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=3600
DRF_NUM_PROXIES=2
WEB_CONCURRENCY=3

# ==== Links in alerts and emails
BACKEND_BASE_URL=https://api.driveoexclusive.com
WEBSITE_BASE_URL=https://driveoexclusive.com

# ==== Alerts (Q1, Q2)
BOOKING_ALERT_EMAILS=
BOOKING_ALERT_WHATSAPP=
# Online changes and cancellations close this many hours before pickup.
BOOKING_CANCEL_NOTICE_HOURS=24
# Minimum notice for a new booking (urgent journeys by phone).
BOOKING_MIN_NOTICE_HOURS=3
DEFAULT_FROM_EMAIL=Driveo Exclusive <no-reply@driveoexclusive.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
